<resources>
    <style name="Theme.ForbiddenStreams" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#7CFF3A</item>
        <!-- Focus/press highlight (also the movie player's settings menu): green -->
        <item name="android:colorControlHighlight">#997CFF3A</item>
    </style>

    <!-- Nov 16: shown by Android the moment the app is opened (black with the logo), until the app is ready. -->
    <style name="Theme.ForbiddenStreams.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0A0A09</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ForbiddenStreams</item>
    </style>
</resources>
